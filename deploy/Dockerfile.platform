FROM node:22-bookworm-slim AS web
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --registry "$NPM_CONFIG_REGISTRY"
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
ARG APT_MIRROR=
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s|http://deb.debian.org/debian|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-platform.txt .
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=pypi.org
RUN pip install --no-cache-dir -i "$PIP_INDEX_URL" --trusted-host "$PIP_TRUSTED_HOST" -r requirements-platform.txt \
    && python -c "import importlib.util, sys; banned=('agno','mcp'); found=[name for name in banned if importlib.util.find_spec(name)]; sys.exit('platform image must not install ' + ','.join(found) if found else 0)"
COPY cvplatform cvplatform
COPY --from=web /web/dist web/dist
RUN useradd --create-home --uid 10001 cvgen \
    && chown -R cvgen /app
ENV PYTHONPATH=/app CVGEN_WEB_DIST=/app/web/dist
USER cvgen
EXPOSE 8093
CMD ["python", "-m", "cvplatform"]
