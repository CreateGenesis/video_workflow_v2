# Copy to deploy/.env. Every secret here must be long and random; never commit the filled file.
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
# Encrypts provider keys at rest and signs media links and webhooks. Changing it invalidates both.
CVGEN_SECRET_KEY=
# The URL people open and that service-API outputs point to, e.g. https://cvgen.example.internal
CVGEN_PUBLIC_BASE=
# Where the API listens on the host (put a TLS reverse proxy in front).
CVGEN_BIND=127.0.0.1:8091
CVGEN_WORKER_THREADS=8
# Optional: imported once into provider instances on first start (then managed in the web console).
AUTODL_API_TOKEN=
# Optional outbound proxy for LLM / image APIs; GPU hosts default to direct connections.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,rustfs
# Optional build mirrors
APT_MIRROR=
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=pypi.org
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
